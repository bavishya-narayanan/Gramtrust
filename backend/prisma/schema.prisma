generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  name               String
  email              String      @unique
  passwordHash       String      @map("password_hash")
  role               UserRole    @default(CITIZEN)
  district           String?
  state              String?
  isActive           Boolean     @default(true) @map("is_active")
  lastLoginAt        DateTime?   @map("last_login_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  id                 String      @id @default(cuid())
  assignedComplaints Complaint[] @relation("AssignedTo")
  filedComplaints    Complaint[] @relation("FiledBy")
  importLogs         ImportLog[]

  @@index([role])
  @@index([district])
  @@index([state])
  @@map("users")
}

model Project {
  district         String
  state            String
  amount           Decimal            @db.Decimal(18, 2)
  blockchainHash   String?            @map("blockchain_hash")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  code             String             @unique
  financialYear    String
  id               String             @id @default(cuid())
  name             String
  status           String
  blockchainStatus String             @default("Pending") @map("blockchain_status")
  integrityStatus  String             @default("Review Required") @map("integrity_status")
  records          BlockchainRecord[]
  complaints       Complaint[]
  audits           IntegrityAudit[]

  @@index([state])
  @@index([district])
  @@index([financialYear])
  @@index([status])
  @@index([blockchainStatus])
  @@index([integrityStatus])
  @@index([district], map: "idx_projects_district")
  @@index([state], map: "idx_projects_state")
  @@index([status], map: "idx_projects_status")
  @@map("projects")
}

model BlockchainRecord {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  txHash    String   @unique @map("tx_hash")
  action    String
  amount    Decimal  @db.Decimal(18, 2)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@index([projectId], map: "idx_blockchain_project")
  @@map("blockchain_records")
}

model IntegrityAudit {
  projectId        String?  @map("project_id")
  databaseAmount   Decimal  @map("database_amount") @db.Decimal(18, 2)
  blockchainAmount Decimal  @map("blockchain_amount") @db.Decimal(18, 2)
  notes            Json?
  createdAt        DateTime @default(now()) @map("created_at")
  difference       Decimal  @db.Decimal(18, 2)
  id               String   @id @default(cuid())
  status           String
  project          Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([projectId], map: "idx_audit_project")
  @@map("integrity_audits")
}

model ImportLog {
  filename       String
  importDate     DateTime     @default(now()) @map("import_date")
  totalRecords   Int          @default(0) @map("total_records")
  successCount   Int          @default(0) @map("success_count")
  failedCount    Int          @default(0) @map("failed_count")
  skippedCount   Int          @default(0) @map("skipped_count")
  status         ImportStatus @default(Success)
  errorDetails   Json?        @map("error_details")
  importedBy     String?      @map("imported_by")
  fileSizeBytes  BigInt?      @map("file_size_bytes")
  checksumSha256 String?      @map("checksum_sha256")
  id             String       @id @default(cuid())
  importer       User?        @relation(fields: [importedBy], references: [id])

  @@index([importDate(sort: Desc)])
  @@index([status])
  @@map("import_logs")
}

model Complaint {
  projectId       String?           @map("project_id")
  filedBy         String?           @map("filed_by")
  assignedTo      String?           @map("assigned_to")
  title           String
  description     String
  priority        ComplaintPriority @default(Medium)
  status          ComplaintStatus   @default(Open)
  resolutionNotes String?           @map("resolution_notes")
  resolvedAt      DateTime?         @map("resolved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  id              String            @id @default(cuid())
  assignee        User?             @relation("AssignedTo", fields: [assignedTo], references: [id])
  filer           User?             @relation("FiledBy", fields: [filedBy], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([filedBy])
  @@index([status])
  @@index([priority])
  @@index([createdAt(sort: Desc)])
  @@index([projectId], map: "idx_complaints_project")
  @@map("complaints")
}

model document_records {
  id                  String    @id @db.VarChar(50)
  project_id          String?   @db.VarChar(50)
  document_name       String    @db.VarChar(255)
  document_type       String    @db.VarChar(100)
  file_path           String?
  sha256_hash         String    @db.VarChar(64)
  amount              Decimal?  @db.Decimal(18, 5)
  blockchain_hash     String?   @db.VarChar(64)
  blockchain_tx_id    String?   @db.VarChar(255)
  blockchain_status   String?   @default("PENDING") @db.VarChar(50)
  source_dataset      String?   @db.VarChar(255)
  verification_status String?   @default("PENDING") @db.VarChar(50)
  is_tampered         Boolean?  @default(false)
  uploaded_by         String?   @db.VarChar(50)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  verified_at         DateTime? @db.Timestamp(6)

  @@index([sha256_hash], map: "idx_document_records_hash")
  @@index([project_id], map: "idx_document_records_project")
  @@index([verification_status], map: "idx_documents_verification")
}

enum UserRole {
  ADMIN
  OFFICIAL
  CITIZEN
}

enum ImportStatus {
  Success
  Partial
  Failed
}

enum ComplaintStatus {
  Open
  UnderInvestigation
  Resolved
  Closed
  Rejected
}

enum ComplaintPriority {
  Low
  Medium
  High
  Critical
}
